---
import { hobbies } from '../data/hobby';
import { oshi, type OshiItem } from '../data/oshi';

// 推しを category ごとにグループ化する。
// グループ順＝カテゴリが最初に現れた順、グループ内は配列順のまま。category 未指定は見出しなしで最後に置く。
const oshiGroups: { category?: string; items: OshiItem[] }[] = [];
const uncategorized: OshiItem[] = [];
for (const o of oshi) {
  if (!o.category) {
    uncategorized.push(o);
    continue;
  }
  const group = oshiGroups.find((g) => g.category === o.category);
  if (group) group.items.push(o);
  else oshiGroups.push({ category: o.category, items: [o] });
}
if (uncategorized.length > 0) oshiGroups.push({ items: uncategorized });

// highlight の色を枠用の linear-gradient にする（1色なら同色2点で単色扱い）
const hlStyle = (o: OshiItem) => {
  if (!o.highlight?.length) return undefined;
  const colors = o.highlight.length === 1 ? [o.highlight[0], o.highlight[0]] : o.highlight;
  return `--hl: linear-gradient(90deg, ${colors.join(', ')})`;
};
---

<div class="hobby-box section" id="hobby">
  <div class="main-content">
    <h1 class="section-title"><span>HOBBY</span></h1>

    <ul class="hobby-list">
      {hobbies.map((h) => (
        <li class="hobby-item">
          <span class="hobby-title">{h.title}</span>
          {h.description && <span class="hobby-desc">{h.description}</span>}
        </li>
      ))}
    </ul>

    <h2 class="subsection-title">推し</h2>
    <div class="oshi-groups">
      {oshiGroups.map((g) => (
        <div class="oshi-group">
          {g.category && oshiGroups.length > 1 && <p class="oshi-group-title">{g.category}</p>}
          <ul class="oshi-list">
            {g.items.map((o) => (
              <li>
                {o.url ? (
                  <a class:list={['oshi-badge', 'oshi-badge-link', { 'oshi-badge-hl': o.highlight?.length }]} style={hlStyle(o)} href={o.url} target="_blank" rel="noopener noreferrer">
                    <span class="oshi-name">{o.name}</span>
                    {o.description && <span class="oshi-desc">{o.description}</span>}
                  </a>
                ) : (
                  <span class:list={['oshi-badge', { 'oshi-badge-hl': o.highlight?.length }]} style={hlStyle(o)}>
                    <span class="oshi-name">{o.name}</span>
                    {o.description && <span class="oshi-desc">{o.description}</span>}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* ===== 趣味（テキスト主体のコンパクトカード） ===== */
  .hobby-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hobby-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: 8px 14px;
  }

  .hobby-title {
    font-size: 14px;
    font-weight: bold;
  }

  .hobby-desc {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* ===== サブセクション見出し（推し） ===== */
  .subsection-title {
    font-size: 1.1em;
    font-weight: bold;
    letter-spacing: 0.08em;
    margin: 36px 0 16px;
    padding-left: 10px;
    border-left: 4px solid var(--color-accent);
    line-height: 1.3;
  }

  /* ===== 推し（文字のみ。カテゴリ見出し＋アウトラインのバッジ） ===== */
  .oshi-groups {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .oshi-group-title {
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.05em;
    margin: 0 0 8px;
  }

  /* 趣味リスト（.hobby-list / .hobby-item）と同じ寸法・見た目に揃える */
  .oshi-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .oshi-badge {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    max-width: 100%;
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: 8px 14px;
    color: inherit;
    text-decoration: none;
  }

  .oshi-badge-link:hover {
    border-color: var(--color-border);
  }

  /* highlight 指定の推し: 太字＋2px のカラー枠（--hl のグラデを border-box に敷き、padding-box は白で塗る）。
     枠が1px→2pxになる分 padding を1px減らし、枠太りで寸法がずれないようにする */
  .oshi-badge-hl {
    border: 2px solid transparent;
    padding: 7px 13px;
    background: linear-gradient(#fff, #fff) padding-box, var(--hl) border-box;
  }

  .oshi-badge-hl .oshi-name {
    font-size: 16px;
  }

  /* hover の黒枠はグラデ枠を潰すので、強調バッジでは変えない */
  .oshi-badge-hl.oshi-badge-link:hover {
    border-color: transparent;
  }

  .oshi-name {
    font-size: 14px;
    font-weight: bold;
  }

  .oshi-desc {
    font-size: 12px;
    color: var(--color-text-muted);
  }
</style>
