---
// 論文・学会発表の h2 サブセクション。
// セクションに依存しない自己完結コンポーネントなので、置き場所を変えたいときは
// 好きなセクション（Career.astro / Works.astro など）の .main-content 内で
// <Publications /> を1行呼ぶだけでよい。データが空なら何も出力しない。
import { publications, selfNames } from '../data/publications';

// 著者リストのうち selfNames に一致する部分だけ太字にするための分割処理。
// 長い表記から順に照合して、短い表記が部分一致で先に食わないようにする。
const escapeRegExp = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const selfNamePattern =
  selfNames.length > 0
    ? new RegExp(
        `(${[...selfNames]
          .sort((a, b) => b.length - a.length)
          .map(escapeRegExp)
          .join('|')})`,
        'g',
      )
    : null;

const splitAuthors = (authors: string) => {
  if (!selfNamePattern) return [{ text: authors, isSelf: false }];
  return authors
    .split(selfNamePattern)
    .filter((part) => part !== '')
    .map((part) => ({ text: part, isSelf: selfNames.includes(part) }));
};
---

{publications.length > 0 && (
  <div class="publications" id="publications">
    <h2 class="subsection-title">Publications</h2>
    <ul class="pub-list">
      {publications.map((p) => (
        <li class="pub-item">
          {((p.awards && p.awards.length > 0) || (p.tags && p.tags.length > 0)) && (
            <div class="pub-tags">
              {p.awards?.map((award) => (
                <span class="pub-award">
                  <i class="fa-solid fa-trophy" aria-hidden="true"></i>
                  {award}
                </span>
              ))}
              {p.tags?.map((tag) => (
                <span class="pub-type">{tag}</span>
              ))}
            </div>
          )}
          <p class="pub-title">
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                {p.title}
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </a>
            ) : (
              p.title
            )}
          </p>
          {p.authors && (
            <p class="pub-authors">
              {splitAuthors(p.authors).map((part) =>
                part.isSelf ? <strong>{part.text}</strong> : part.text,
              )}
            </p>
          )}
          <p class="pub-venue">{p.venue}, {p.date}</p>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  /* 直前の要素との間隔は自分で持つ（どのセクションに置いても見た目が変わらないように） */
  .publications {
    margin-top: 48px;
  }

  /* ===== サブセクション見出し（Publications） ===== */
  .subsection-title {
    font-size: 1.1em;
    font-weight: bold;
    letter-spacing: 0.08em;
    margin: 0 0 20px;
    padding-left: 10px;
    border-left: 4px solid var(--color-accent);
    line-height: 1.3;
  }

  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pub-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 2px;
  }

  .pub-type {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    background: var(--color-accent);
    color: #fff;
  }

  .pub-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    line-height: 1.5;
  }

  .pub-title a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: #08c;
  }

  .pub-title a:hover {
    color: #069;
    text-decoration: underline;
  }

  .pub-title a i {
    font-size: 0.7em;
    color: var(--color-text-muted);
  }

  .pub-authors {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .pub-authors strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .pub-venue {
    font-size: 13px;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
    line-height: 1.6;
  }

  /*
   * 受賞バッジ。白地＋金枠＋金文字＋トロフィーで、黒地のタグ（.pub-type）と区別する。
   * 色は global.css の --color-award / --color-award-border。
   * 枠線 1px の分 padding を 1px 減らして、外寸をタグ（padding 2px 6px）と揃えている。
   */
  .pub-award {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 1px 5px;
    background: var(--color-bg);
    color: var(--color-award);
    border: 1px solid var(--color-award-border);
  }
</style>
