---
import { works } from '../data/works';
import { publications, selfNames } from '../data/publications';

// 著者リストのうち selfNames に一致する部分だけ太字にするための分割処理。
// 長い表記から順に照合して、短い表記が部分一致で先に食わないようにする。
const escapeRegExp = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const selfNamePattern =
  selfNames.length > 0
    ? new RegExp(
        `(${[...selfNames]
          .sort((a, b) => b.length - a.length)
          .map(escapeRegExp)
          .join('|')})`,
        'g',
      )
    : null;

const splitAuthors = (authors: string) => {
  if (!selfNamePattern) return [{ text: authors, isSelf: false }];
  return authors
    .split(selfNamePattern)
    .filter((part) => part !== '')
    .map((part) => ({ text: part, isSelf: selfNames.includes(part) }));
};
---

<div class="works-box section" id="work">
  <div class="main-content">
    <h1 class="section-title"><span>WORK</span></h1>
    <div class="work-grid">
      {works.map((w) => (
        <a href={w.url} class="work-card" target="_blank" rel="noopener noreferrer">
          <div class="work-img">
            <img src={w.img} alt={w.title} loading="lazy" />
          </div>
          <div class="work-body">
            <p class="work-title">{w.title}</p>
            <p class="work-desc">{w.description}</p>
          </div>
        </a>
      ))}
    </div>

    {publications.length > 0 && (
      <div class="publications" id="publications">
        <h2 class="subsection-title">Publications</h2>
        <ul class="pub-list">
          {publications.map((p) => (
            <li class="pub-item">
              {p.type && <span class="pub-type">{p.type}</span>}
              <p class="pub-title">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener noreferrer">
                    {p.title}
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                ) : (
                  p.title
                )}
              </p>
              {p.authors && (
                <p class="pub-authors">
                  {splitAuthors(p.authors).map((part) =>
                    part.isSelf ? <strong>{part.text}</strong> : part.text,
                  )}
                </p>
              )}
              <p class="pub-venue">{p.venue}, {p.date}</p>
              {p.award && <span class="pub-award">{p.award}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</div>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .work-card {
    display: block;
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .work-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }

  .work-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .work-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-body {
    padding: 14px 16px 16px;
  }

  .work-title {
    font-size: 15px;
    font-weight: bold;
    margin: 0 0 6px;
  }

  .work-desc {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== Publications（Work 内の h2 サブセクション） ===== */
  .publications {
    margin-top: 48px;
  }

  .subsection-title {
    font-size: 1.1em;
    font-weight: bold;
    letter-spacing: 0.08em;
    margin: 0 0 20px;
    padding-left: 10px;
    border-left: 4px solid var(--color-accent);
    line-height: 1.3;
  }

  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pub-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pub-type {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    margin-bottom: 2px;
    background: var(--color-accent);
    color: #fff;
  }

  .pub-title {
    font-size: 15px;
    font-weight: 700;
    margin: 0;
    line-height: 1.5;
  }

  .pub-title a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: #08c;
  }

  .pub-title a:hover {
    color: #069;
    text-decoration: underline;
  }

  .pub-title a i {
    font-size: 0.7em;
    color: var(--color-text-muted);
  }

  .pub-authors {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .pub-authors strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .pub-venue {
    font-size: 13px;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
    line-height: 1.6;
  }

  .pub-award {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    margin-top: 4px;
    padding: 2px 8px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
</style>
